# Build and test output, anchored so a folder of the same name elsewhere is kept.
/bin/
/dist/
/coverage.out
/coverage.kept.out
/coverage.html
# Binaries and test binaries built by hand (go build, go test -c)
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.coverprofile
# A Go workspace is a local arrangement, not the module's
go.work
go.work.sum
# Secrets never go in the repository
.env
# Editors
.idea/
.vscode/
*.swp
# -o html pages written while trying commands
/ldo-go-*.html
